# ViralDesk secrets — NEVER commit, never paste into chat.
# Copy this file to .env and fill in values. All keys stay on this machine.

# TikTok — needed for TikTok link fetching (official Research/Display API app key)
TIKTOK_API_KEY=

# Telegram — needed for Telegram channel post fetching (bot token from @BotFather)
TELEGRAM_BOT_TOKEN=

